{
  "gopls.directoryFilters": [
    "-go-local/test",
    "-go-local/test/**",
    "-go-local/src/**/testdata",
    "-go-local/src/**/testdata/**",
    "-**/node_modules"
  ],
  "files.exclude": {
    "go-local/test": true
  },
  "search.exclude": {
    "go-local/test": true
  },
  "files.watcherExclude": {
    "go-local/test/**": true,
    "**/node_modules/**": true
  }
}
