FROM ubuntu:24.04
ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive
STOPSIGNAL SIGRTMIN+3

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus ca-certificates curl wget openssl \
    iproute2 iputils-ping jq netcat-traditional \
    git golang-go build-essential pkg-config \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY docker/lab/bootstrap-panel.sh /usr/local/bin/bootstrap-panel.sh
COPY docker/lab/scripts/register-agents.sh /usr/local/bin/register-agents.sh
COPY docker/lab/systemd/lab-panel-bootstrap.service /etc/systemd/system/lab-panel-bootstrap.service
COPY . /opt/3x-ui

RUN sed -i 's/\r$//' /opt/3x-ui/install.sh /opt/3x-ui/install-noninteractive.sh \
  /usr/local/bin/bootstrap-panel.sh /usr/local/bin/register-agents.sh \
  && chmod +x /usr/local/bin/bootstrap-panel.sh /usr/local/bin/register-agents.sh \
  && ln -s /etc/systemd/system/lab-panel-bootstrap.service /etc/systemd/system/multi-user.target.wants/lab-panel-bootstrap.service

VOLUME ["/sys/fs/cgroup"]
CMD ["/sbin/init"]
